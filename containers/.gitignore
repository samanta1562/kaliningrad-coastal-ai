# Исключение тяжелых слоев озера данных, весов моделей и бэкапов
data_lake/bronze/
data_lake/silver/
data_lake/feature_store/*.duckdb*
data_lake/gold/models/*.pt
data_lake/gold/models/*.cbm
data_lake/gold/models/*.pkl
data_lake/backups/*.tar.gz
data_lake/logs/*.log

# Оставляем в Git только паспорта метрик и визуальные отчеты для ВКР
!data_lake/gold/models/*.json
!data_lake/gold/reports/*.png

# Виртуальные окружения, кэш Python и Pytest
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Секреты и системные файлы ОС
.env
.DS_Store
